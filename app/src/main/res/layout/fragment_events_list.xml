<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_light">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Header Bar -->
            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="40dp"
                android:fontFamily="sans-serif-black"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/btnFilterOptions"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/btnFilterOptions"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Filtros e ordenação"
                android:src="@drawable/ic_filter_list"
                app:layout_constraintBottom_toBottomOf="@id/tvHeaderTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvHeaderTitle" />

            <!-- Rounded Search Box Container -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSearch"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@color/surface_white"
                app:cardCornerRadius="@dimen/search_corner_radius"
                app:cardElevation="1dp"
                app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle"
                app:strokeWidth="1dp"
                app:strokeColor="@color/divider_color">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Buscar"
                        android:src="@drawable/ic_search" />

                    <EditText
                        android:id="@+id/etSearchQuery"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/btnClearSearch"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Limpar busca"
                        android:src="@drawable/ic_clear"
                        android:visibility="gone" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Offline Status Banner -->
            <TextView
                android:id="@+id/tvOfflineBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFF3CD"
                android:gravity="center"
                android:padding="6dp"
                android:text="@string/error_offline"
                android:textColor="#856404"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/cardSearch" />

            <!-- CATEGORIAS Section -->
            <TextView
                android:id="@+id/tvCategoriesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/section_categories"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvOfflineBanner" />

            <!-- Sort Indicator Label -->
            <TextView
                android:id="@+id/tvCurrentSort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:drawableStart="@drawable/ic_filter_list"
                android:drawablePadding="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/primary_blue"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@id/tvCategoriesLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvCategoriesLabel"
                tools:text="Data (mais próxima)" />

            <!-- Categories Horizontal Scroll -->
            <HorizontalScrollView
                android:id="@+id/scrollCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:scrollbars="none"
                app:layout_constraintTop_toBottomOf="@id/tvCategoriesLabel">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCategoryAll"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/category_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCategoryAndroid"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_android" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCategoryKotlin"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_kotlin" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCategoryBackend"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_backend" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCategoryWeb"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_web" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCategoryIA"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_ia" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCategoryCloud"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_cloud" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCategoryDevOps"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/category_devops" />

                </com.google.android.material.chip.ChipGroup>

            </HorizontalScrollView>

            <!-- FORMATO Section -->
            <TextView
                android:id="@+id/tvFormatLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/section_format"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/scrollCategories" />

            <!-- Format & Status Horizontal Scroll -->
            <HorizontalScrollView
                android:id="@+id/scrollFormats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:scrollbars="none"
                app:layout_constraintTop_toBottomOf="@id/tvFormatLabel">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupFormat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFormatAll"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/format_all" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFormatPresencial"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/format_presencial" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFormatOnline"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/format_online" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFormatFavorites"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/favorites_only"
                        app:chipIcon="@drawable/ic_favorite"
                        app:chipIconTint="@color/favorite_red" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFormatFinished"
                        style="@style/Widget.MaterialComponents.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Finalizados" />

                </com.google.android.material.chip.ChipGroup>

            </HorizontalScrollView>

            <!-- Main Content Container: RecyclerView & States -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/scrollFormats">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvEventsList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="80dp"
                    tools:listitem="@layout/item_event" />

                <!-- Initial Full-Screen ProgressBar -->
                <ProgressBar
                    android:id="@+id/pbInitialLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/primary_blue"
                    android:visibility="gone" />

                <!-- Empty State Include -->
                <include
                    android:id="@+id/emptyStateView"
                    layout="@layout/layout_empty_state"
                    android:visibility="gone" />

                <!-- Error State Include -->
                <include
                    android:id="@+id/errorStateView"
                    layout="@layout/layout_error_state"
                    android:visibility="gone" />

            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- FloatingActionButton for Event Creation -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabCreateEvent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="24dp"
            android:contentDescription="Criar evento"
            android:src="@drawable/ic_add"
            app:backgroundTint="@color/primary_blue"
            app:tint="@color/white" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
