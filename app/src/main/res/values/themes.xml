<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base Application Theme -->
    <style name="Theme.TechEvents" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_blue_light</item>
        <item name="colorSecondary">@color/secondary_purple</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/secondary_purple_light</item>
        <item name="android:statusBarColor">@color/primary_blue_dark</item>
        <item name="android:windowBackground">@color/background_light</item>
    </style>

    <!-- SplashScreen Theme -->
    <style name="Theme.TechEvents.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="windowSplashScreenBackground">@color/surface_white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_tech_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.TechEvents</item>
    </style>

</resources>
